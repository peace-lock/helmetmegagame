DATABASE_URL="postgresql://user:password@localhost:5432/lifeweb"

# Shared: the bot token, also used by the web app's server-side REST calls
# to read guild member roles (see web/lib/discordGuild.js).
DISCORD_TOKEN=""

# The single Discord server this game instance runs in.
DISCORD_GUILD_ID=""

# The Discord role ID that grants access to the /gm dashboard.
DISCORD_GM_ROLE_ID=""

# The Discord role ID pinged by turn-advance announcements. Player membership
# is synced automatically from the "Turn Ping?" checkbox on /character.
DISCORD_TURN_PING_ROLE_ID=""

# The Discord role ID assigned while a player has "Disable Romance Content?"
# checked on /character; removed automatically when unchecked.
DISCORD_NO_ROMANCE_ROLE_ID=""

# The Discord role ID marking a Cursed player. Granted automatically when a
# character dies, removed automatically once they successfully create a new
# one; a GM clears it early (simulating burial/rites) by removing the role
# directly in Discord.
DISCORD_CURSED_ROLE_ID=""

# Discord OAuth app credentials for web login (Discord Developer Portal ->
# OAuth2). Redirect URI: <your-web-url>/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Auth.js session secret. Generate with: npx auth secret
AUTH_SECRET=""

# Public URL of the deployed web service. The bot uses this to build avatar
# URLs (<WEB_BASE_URL>/api/avatar/<characterId>) when proxying messages.
WEB_BASE_URL=""

# Optional. Pins the web app to one theme instead of following the turn phase:
# "dusk", "dawn", or "limestone". Only exists so limestone — the light-theme
# backup, which no phase maps to — can be viewed and compared. Leave unset in
# production. An unrecognised value falls back to the phase theme.
LIFEWEB_THEME=""
